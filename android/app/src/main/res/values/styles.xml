<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Opaque cream + icon for the cold start only. After first paint the
         activity replaces this with a flat cream so the piece graphic never
         returns mid-session. Never use the old translucent application theme. -->
    <style name="Theme.OpeningLab.Launcher" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_screen</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:navigationBarColor">@color/navigationColor</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
